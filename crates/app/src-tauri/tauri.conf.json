{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bigman",
  "mainBinaryName": "bigman-app",
  "version": "0.2.0",
  "identifier": "org.bigman.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bigman",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "publisher": "Bigman",
    "homepage": "https://github.com/Zinkelburger/bigman-antivirus",
    "license": "AGPL-3.0-only",
    "shortDescription": "Deterministic security companion for the Linux desktop",
    "longDescription": "Bigman inspects downloads, installer scripts, packages and cloned projects before you run them, notes new network activity and package changes, watches the files that start programs when you log in, and says which security updates matter. Every result comes from a fixed rule with a plain explanation. It includes the desktop app (bigman-app), the command-line tool (bigman) and the per-user background service (bigmand).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "../../../packaging/linux/bigman-hidden.desktop",
        "files": {
          "/usr/bin/bigman": "bundle-bin/bigman",
          "/usr/bin/bigmand": "bundle-bin/bigmand",
          "/usr/share/applications/bigman-app.desktop": "../../../packaging/linux/bigman-app.desktop",
          "/usr/share/icons/hicolor/256x256/apps/bigman-app.png": "icons/128x128@2x.png",
          "/usr/share/doc/bigman/copyright": "../../../LICENSE"
        }
      },
      "rpm": {
        "desktopTemplate": "../../../packaging/linux/bigman-hidden.desktop",
        "files": {
          "/usr/bin/bigman": "bundle-bin/bigman",
          "/usr/bin/bigmand": "bundle-bin/bigmand",
          "/usr/share/applications/bigman-app.desktop": "../../../packaging/linux/bigman-app.desktop",
          "/usr/share/icons/hicolor/256x256/apps/bigman-app.png": "icons/128x128@2x.png",
          "/usr/share/licenses/bigman/LICENSE": "../../../LICENSE"
        }
      }
    }
  }
}
