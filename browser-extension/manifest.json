{
  "manifest_version": 3,
  "name": "BigMan AntiVirus - Link Detector",
  "version": "0.2.0",
  "description": "Deterministic local link checks, sponsored-result marking and optional desktop download scans",
  "permissions": [
    "activeTab",
    "downloads",
    "notifications",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/link-detector.js",
        "search-ads.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BigMan AntiVirus",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "link-detector@bigman-antivirus",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
