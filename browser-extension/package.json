{
  "name": "bigman-antivirus",
  "version": "0.2.0",
  "description": "Browser extension for detecting suspicious links",
  "main": "link-detector.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "node build.js",
    "check": "npm run build && npm test -- --runInBand"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "link-detector.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "keywords": [
    "browser-extension",
    "security",
    "phishing-detection"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "punycode": "2.3.1",
    "tldts": "7.4.12"
  }
}
